// 应用路由配置：ux-router 实例（路由表 path 与 pages.json 注册一致）
import { createRouter } from '@/uni_modules/ux-router/utssdk/index.uts'
import type { RouteConfig } from '@/uni_modules/ux-router/utssdk/index.uts'

/** 路由表：首页 + 十个功能验证页 */
export const routes: RouteConfig[] = [
	{ path: 'pages/index/index', name: 'home', meta: { title: 'unix-request' } },
	{ path: 'pages/url-params/url-params', name: 'url-params', meta: { title: 'URL 与参数' } },
	{ path: 'pages/error-basic/error-basic', name: 'error-basic', meta: { title: '参数与配置错误' } },
	{ path: 'pages/methods/methods', name: 'methods', meta: { title: '请求方法' } },
	{ path: 'pages/body-header/body-header', name: 'body-header', meta: { title: '请求体与请求头' } },
	{ path: 'pages/status-error/status-error', name: 'status-error', meta: { title: '状态码与网络错误' } },
	{ path: 'pages/cancel/cancel', name: 'cancel', meta: { title: '取消请求' } },
	{ path: 'pages/transform/transform', name: 'transform', meta: { title: '数据转换' } },
	{ path: 'pages/interceptors/interceptors', name: 'interceptors', meta: { title: '拦截器' } },
	{ path: 'pages/instances/instances', name: 'instances', meta: { title: '多实例与全局配置' } },
	{ path: 'pages/arraybuffer/arraybuffer', name: 'arraybuffer', meta: { title: '二进制响应' } }
]

export const router = createRouter({ routes, strict: true })
