<script setup lang="uts">
	import { configureRequest } from '@/uni_modules/mx-request'
	import { HOST } from '@/common/test-utils.uts'

	onLaunch(() => {
		// 配置默认实例全局默认（baseURL + 默认 header，供 params/header/全局配置等用例使用）
		const globalHeader: UTSJSONObject = {}
		globalHeader['x-global'] = 'global-default'
		configureRequest({
			baseURL: HOST,
			timeout: 15000,
			header: globalHeader,
			validateStatus: null
		})
	})
</script>

