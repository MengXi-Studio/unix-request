{
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["ESNext"],
    "noImplicitAny": false,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "noImplicitThis": true,
    "strict": true,
    "target": "ESNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.uts",
    "**/*.ts",
    "**/*.d.ts",
    "**/*.vue",
    "**/*.uvue"
  ]
}
